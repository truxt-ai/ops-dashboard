<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Truxt Demo Dashboard</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; color: #1a1a2e; }
    h1 { margin-bottom: 0.25rem; }
    .sub { color: #6b7280; margin-top: 0; }
    table { border-collapse: collapse; margin-top: 1.5rem; min-width: 480px; }
    th, td { text-align: left; padding: 0.5rem 1rem; border-bottom: 1px solid #e5e7eb; }
    th { background: #f3f4f6; }
    .pill { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; background: #eef2ff; color: #4338ca; font-size: 0.85rem; }
    .service-health-summary { margin-top: 1.5rem; max-width: 760px; }
    .service-health-summary h2 { margin-bottom: 0.35rem; }
    .health-message { margin: 0 0 0.75rem; font-weight: 600; }
    .health-message-healthy { color: #15803d; }
    .health-message-attention { color: #b45309; }
    .health-message-empty { color: #6b7280; }
    .health-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); }
    .health-card { border: 1px solid #e5e7eb; border-left: 0.35rem solid #d1d5db; border-radius: 0.5rem; padding: 0.75rem; background: #ffffff; }
    .health-card strong { display: block; margin-top: 0.2rem; font-size: 1.75rem; line-height: 1; }
    .health-label, .health-detail { display: block; }
    .health-label { font-weight: 700; }
    .health-detail { color: #4b5563; font-size: 0.85rem; margin-top: 0.25rem; }
    .health-healthy { border-left-color: #16a34a; background: #f0fdf4; }
    .health-degraded { border-left-color: #d97706; background: #fffbeb; }
    .health-offline { border-left-color: #dc2626; background: #fef2f2; }
    .status { display: inline-block; min-width: 4.6rem; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.85rem; font-weight: 700; text-align: center; }
    .status-healthy { background: #dcfce7; color: #166534; }
    .status-degraded { background: #fef3c7; color: #92400e; }
    .status-offline { background: #fee2e2; color: #991b1b; }
  </style>
</head>
<body>
  <h1>Truxt Demo Dashboard</h1>
  <p class="sub">Service health overview</p>

  <p>
    <span class="pill">Total requests: <%= metrics.totalRequests.toLocaleString() %></span>
    <span class="pill">Total errors: <%= metrics.totalErrors %></span>
    <span class="pill">Error rate: <%= metrics.errorRate %>%</span>
  </p>

  <section class="service-health-summary" data-testid="service-health-summary" aria-labelledby="service-health-summary-title">
    <h2 id="service-health-summary-title">Service health</h2>
    <p class="health-message health-message-<%= metrics.serviceHealthSummary.state %>" data-testid="service-health-message">
      <%= metrics.serviceHealthSummary.message %>
    </p>
    <div class="health-grid" role="list" aria-label="Service health counts">
      <% metrics.serviceHealthSummary.items.forEach(function (item) { %>
        <div class="health-card health-<%= item.key %>" role="listitem" aria-label="<%= item.ariaLabel %>" data-testid="service-health-<%= item.key %>">
          <span class="health-label"><%= item.label %></span>
          <strong data-testid="service-health-<%= item.key %>-count"><%= item.count %></strong>
          <span class="health-detail"><%= item.countLabel %></span>
        </div>
      <% }); %>
    </div>
  </section>

  <table>
    <thead>
      <tr><th>Service</th><th>Status</th><th>Requests</th><th>Errors</th></tr>
    </thead>
    <tbody>
      <% metrics.serviceRows.forEach(function (s) { %>
        <tr>
          <td><%= s.name %></td>
          <td><span class="status status-<%= s.status %>"><%= s.statusLabel %></span></td>
          <td><%= s.requests.toLocaleString() %></td>
          <td><%= s.errors %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>
