<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Truxt Demo Dashboard</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; color: #1a1a2e; }
    h1 { margin-bottom: 0.25rem; }
    .sub { color: #6b7280; margin-top: 0; }
    table { border-collapse: collapse; margin-top: 0.5rem; min-width: 480px; }
    .services-table { overflow-x: auto; }
    .service-search { margin-top: 1rem; }
    .service-search label { display: block; margin-bottom: 0.25rem; }
    .service-search input { box-sizing: border-box; width: 100%; max-width: 24rem; padding: 0.5rem; font: inherit; }
    .health-freshness { display: inline-block; padding: 0.35rem 0.6rem; border: 1px solid #bbf7d0; border-radius: 0.25rem; background: #f0fdf4; color: #166534; }
    .health-freshness--stale { border-color: #f59e0b; background: #fffbeb; color: #92400e; font-weight: 600; }
    th, td { text-align: left; padding: 0.5rem 1rem; border-bottom: 1px solid #e5e7eb; }
    th { background: #f3f4f6; }
    .sort-button { border: 0; background: transparent; color: inherit; font: inherit; font-weight: inherit; padding: 0; cursor: pointer; white-space: nowrap; }
    .sort-button:focus-visible { outline: 2px solid #4338ca; outline-offset: 4px; }
    th[aria-sort] { color: #4338ca; }
    .pill { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; background: #eef2ff; color: #4338ca; font-size: 0.85rem; }
    .service-status { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 0.25rem; }
    .service-status--failing { background: #fee2e2; color: #991b1b; font-weight: 700; }
    .service-status--degraded { background: #fffbeb; color: #92400e; }
    .service-status--healthy { background: #f0fdf4; color: #166534; }
  </style>
</head>
<body>
  <h1>Truxt Demo Dashboard</h1>
  <p class="sub">Service health overview</p>

  <p>
    <span class="pill">Total requests: <%= metrics.totalRequests.toLocaleString() %></span>
    <span class="pill">Total errors: <%= metrics.totalErrors %></span>
    <span class="pill">Error rate: <%= metrics.errorRate %>%</span>
  </p>

  <time class="health-freshness<%= freshness.stale ? ' health-freshness--stale' : '' %>" datetime="<%= freshness.isoTimestamp %>"><%= freshness.label %></time>
  <div class="service-search">
    <label for="service-search">Search services</label>
    <input id="service-search" type="search">
  </div>
  <div class="services-table">
  <table>
    <thead>
      <tr><th>Service</th><th>Status</th><th><button type="button" class="sort-button" data-sort="requests">Requests<span aria-hidden="true"></span></button></th><th><button type="button" class="sort-button" data-sort="errors">Errors<span aria-hidden="true"></span></button></th><th><button type="button" class="sort-button" data-sort="errorRate">Error rate<span aria-hidden="true"></span></button></th></tr>
    </thead>
    <tbody>
      <% metrics.services.forEach(function (s) { %>
        <tr data-service-row data-requests="<%= s.requests %>" data-errors="<%= s.errors %>" data-error-rate="<%= s.errorRate %>">
          <td><%= s.name %></td>
          <td><span class="service-status service-status--<%= s.status %>"><%= s.statusLabel %></span></td>
          <td><%= s.requests.toLocaleString() %></td>
          <td><%= s.errors %></td>
          <td><%= s.errorRate %>%</td>
        </tr>
      <% }); %>
      <tr id="no-matching-services" hidden>
        <td colspan="5">No matching services</td>
      </tr>
    </tbody>
  </table>
  </div>
  <script>
    const search = document.getElementById('service-search');
    const rows = document.querySelectorAll('[data-service-row]');
    const noMatches = document.getElementById('no-matching-services');
    const sortButtons = document.querySelectorAll('[data-sort]');
    const originalRows = Array.from(rows);
    let activeKey;
    let direction;
    sortButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        const key = button.dataset.sort;
        direction = activeKey === key && direction === 'descending' ? 'ascending' : 'descending';
        activeKey = key;
        originalRows.map(function (row, index) { return { row, index }; })
          .sort(function (a, b) {
            const difference = Number(a.row.dataset[key]) - Number(b.row.dataset[key]);
            return (direction === 'descending' ? -difference : difference) || a.index - b.index;
          }).forEach(function (entry) {
            noMatches.parentNode.insertBefore(entry.row, noMatches);
          });
        sortButtons.forEach(function (headerButton) {
          const active = headerButton.dataset.sort === activeKey;
          if (active) headerButton.parentNode.setAttribute('aria-sort', direction);
          else headerButton.parentNode.removeAttribute('aria-sort');
          headerButton.querySelector('span').textContent = active ? (direction === 'descending' ? ' ↓' : ' ↑') : '';
        });
      });
    });
    search.addEventListener('input', function () {
      const query = search.value.toLowerCase();
      let matches = 0;
      rows.forEach(function (row) {
        const matchesName = row.querySelector('td').textContent.toLowerCase().includes(query);
        row.hidden = !matchesName;
        if (matchesName) matches++;
      });
      noMatches.hidden = query === '' || matches > 0;
    });
  </script>
</body>
</html>
