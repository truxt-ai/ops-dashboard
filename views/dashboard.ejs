<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Truxt Demo Dashboard</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; color: #1a1a2e; }
    h1 { margin-bottom: 0.25rem; }
    .sub { color: #6b7280; margin-top: 0; }
    .status-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; align-items: center; margin: 0.75rem 0 1.25rem; color: #374151; }
    .status-legend__item { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; line-height: 1.25; }
    .status-marker { flex: 0 0 auto; width: 0.75rem; height: 0.75rem; border: 2px solid currentColor; }
    .status-marker--healthy { color: #047857; background: #d1fae5; border-radius: 999px; }
    .status-marker--degraded { color: #b45309; background: #fef3c7; border-radius: 2px; transform: rotate(45deg); }
    .status-marker--unhealthy { color: #b91c1c; background: #fee2e2; border-radius: 2px; }
    table { border-collapse: collapse; margin-top: 1.5rem; min-width: 480px; }
    th, td { text-align: left; padding: 0.5rem 1rem; border-bottom: 1px solid #e5e7eb; }
    th { background: #f3f4f6; }
    .pill { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; background: #eef2ff; color: #4338ca; font-size: 0.85rem; }
    @media (max-width: 560px) {
      body { margin: 1rem; }
      .status-legend { align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>
<body>
  <h1>Truxt Demo Dashboard</h1>
  <p class="sub">Service health overview</p>

  <section class="status-legend" aria-label="Status legend">
    <span class="status-legend__item">
      <span class="status-marker status-marker--healthy" data-status-marker="healthy" aria-hidden="true"></span>
      <span>Healthy</span>
    </span>
    <span class="status-legend__item">
      <span class="status-marker status-marker--degraded" data-status-marker="degraded" aria-hidden="true"></span>
      <span>Degraded</span>
    </span>
    <span class="status-legend__item">
      <span class="status-marker status-marker--unhealthy" data-status-marker="unhealthy" aria-hidden="true"></span>
      <span>Unhealthy</span>
    </span>
  </section>

  <p>
    <span class="pill">Total requests: <%= metrics.totalRequests.toLocaleString() %></span>
    <span class="pill">Total errors: <%= metrics.totalErrors %></span>
    <span class="pill">Error rate: <%= metrics.errorRate %>%</span>
  </p>

  <table>
    <thead>
      <tr><th>Service</th><th>Requests</th><th>Errors</th></tr>
    </thead>
    <tbody>
      <% metrics.services.forEach(function (s) { %>
        <tr>
          <td><%= s.name %></td>
          <td><%= s.requests.toLocaleString() %></td>
          <td><%= s.errors %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>
