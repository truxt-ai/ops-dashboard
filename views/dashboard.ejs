<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Truxt Demo Dashboard</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; color: #1a1a2e; }
    h1 { margin-bottom: 0.25rem; }
    .sub { color: #6b7280; margin-top: 0; }
    table { border-collapse: collapse; margin-top: 1.5rem; min-width: 480px; }
    th, td { text-align: left; padding: 0.5rem 1rem; border-bottom: 1px solid #e5e7eb; }
    th { background: #f3f4f6; }
    .pill { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; background: #eef2ff; color: #4338ca; font-size: 0.85rem; }
    .health-summary { margin-top: 1.5rem; padding: 1rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; }
    .health-summary h2 { margin: 0 0 0.75rem; font-size: 1.1rem; }
    .health-counts { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
    .health-count { min-width: 8rem; padding: 0.75rem; border-left: 0.25rem solid #16a34a; background: #f0fdf4; }
    .health-count strong { display: block; font-size: 1.5rem; line-height: 1; }
    .health-count--degraded { border-left-color: #d97706; background: #fffbeb; }
    .health-count--offline { border-left-color: #dc2626; background: #fef2f2; }
    .all-clear { margin: 0 0 0.75rem; color: #166534; font-weight: 600; }
    .status-label { text-transform: capitalize; }
  </style>
</head>
<body>
  <h1>Truxt Demo Dashboard</h1>
  <p class="sub">Service health overview</p>

  <p>
    <span class="pill">Total requests: <%= metrics.totalRequests.toLocaleString() %></span>
    <span class="pill">Total errors: <%= metrics.totalErrors %></span>
    <span class="pill">Error rate: <%= metrics.errorRate %>%</span>
  </p>

  <%
    const serviceHealthSummary = metrics.serviceHealthSummary
      || (typeof summarizeServiceHealth === 'function'
        ? summarizeServiceHealth(metrics.services)
        : require(process.cwd() + '/src/lib/service-health-summary').summarizeServiceHealth(metrics.services));
  %>

  <section class="health-summary" data-testid="service-health-summary" aria-labelledby="service-health-heading">
    <h2 id="service-health-heading">Service health</h2>
    <% if (serviceHealthSummary.allClear) { %>
      <p class="all-clear" data-testid="service-health-all-clear">All services healthy.</p>
    <% } %>
    <ul class="health-counts" aria-label="Service health counts">
      <% serviceHealthSummary.items.forEach(function (item) { %>
        <li class="health-count health-count--<%= item.bucket %>" data-testid="service-health-count-<%= item.bucket %>">
          <strong><%= item.count %></strong>
          <span><%= item.label %></span>
        </li>
      <% }); %>
    </ul>
  </section>

  <table>
    <thead>
      <tr><th>Service</th><th>Status</th><th>Requests</th><th>Errors</th></tr>
    </thead>
    <tbody>
      <% metrics.services.forEach(function (s) { %>
        <tr>
          <td><%= s.name %></td>
          <td class="status-label"><%= s.status %></td>
          <td><%= s.requests.toLocaleString() %></td>
          <td><%= s.errors %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>
