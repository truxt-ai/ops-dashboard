<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Truxt Demo Dashboard</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; color: #1a1a2e; }
    h1 { margin-bottom: 0.25rem; }
    .sub { color: #6b7280; margin-top: 0; }
    table { border-collapse: collapse; margin-top: 1.5rem; min-width: 480px; }
    th, td { text-align: left; padding: 0.5rem 1rem; border-bottom: 1px solid #e5e7eb; }
    th { background: #f3f4f6; }
    .pill { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; background: #eef2ff; color: #4338ca; font-size: 0.85rem; }
    .plans { margin-top: 2rem; max-width: 980px; }
    .plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; margin-top: 1rem; }
    .plan-card { border: 1px solid #d1d5db; border-radius: 8px; padding: 1rem; background: #fff; }
    .plan-card h3 { margin: 0 0 0.35rem; }
    .plan-card p { margin: 0.35rem 0; }
    .plan-price { font-weight: 700; color: #065f46; }
    .plan-card ul { margin: 0.75rem 0 1rem; padding-left: 1.2rem; }
    .plan-card li { margin: 0.25rem 0; }
    .plan-card button { width: 100%; min-height: 2.4rem; border: 0; border-radius: 6px; background: #1f2937; color: white; font-weight: 700; cursor: pointer; }
    .plan-card button:disabled { background: #e5e7eb; color: #6b7280; cursor: not-allowed; }
    .plan-note { color: #6b7280; font-size: 0.9rem; }
  </style>
</head>
<body>
  <h1>Truxt Demo Dashboard</h1>
  <p class="sub">Service health overview</p>

  <p>
    <span class="pill">Total requests: <%= metrics.totalRequests.toLocaleString() %></span>
    <span class="pill">Total errors: <%= metrics.totalErrors %></span>
    <span class="pill">Error rate: <%= metrics.errorRate %>%</span>
  </p>

  <table>
    <thead>
      <tr><th>Service</th><th>Requests</th><th>Errors</th></tr>
    </thead>
    <tbody>
      <% metrics.services.forEach(function (s) { %>
        <tr>
          <td><%= s.name %></td>
          <td><%= s.requests.toLocaleString() %></td>
          <td><%= s.errors %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <section class="plans" aria-labelledby="plan-selection-heading" data-test="billing-plans" data-testid="billing-plans">
    <h2 id="plan-selection-heading">Subscription plans</h2>
    <p class="sub">Choose a workspace plan to start Stripe Checkout.</p>

    <div class="plan-grid">
      <% const dashboardPlans = typeof plans !== 'undefined' && Array.isArray(plans) ? plans : []; %>
      <% dashboardPlans.forEach(function (plan) { %>
        <article class="plan-card" aria-labelledby="plan-heading-<%= plan.id %>" data-test="billing-plan-card-<%= plan.id %>" data-testid="billing-plan-card-<%= plan.id %>">
          <h3 id="plan-heading-<%= plan.id %>"><%= plan.name %></h3>
          <p class="plan-price" data-test="plan-price-<%= plan.id %>" data-testid="plan-price-<%= plan.id %>"><%= plan.monthlyLabel %></p>
          <p><%= plan.summary %></p>

          <ul aria-label="<%= plan.name %> plan features">
            <% plan.features.forEach(function (feature) { %>
              <li><%= feature %></li>
            <% }); %>
          </ul>

          <% if (plan.requiresCheckout) { %>
            <form method="post" action="/api/billing/checkout/session" data-test="billing-checkout-form-<%= plan.id %>" data-testid="billing-checkout-form-<%= plan.id %>">
              <input type="hidden" name="planId" value="<%= plan.id %>">
              <input type="hidden" name="workspaceId" value="demo-workspace">
              <button type="submit" aria-label="Choose <%= plan.name %> plan" data-test="start-checkout-<%= plan.id %>" data-testid="start-checkout-<%= plan.id %>">
                Start checkout
              </button>
            </form>
          <% } else { %>
            <p class="plan-note" data-test="billing-plan-current-free" data-testid="billing-plan-current-free">Included for every workspace</p>
          <% } %>
        </article>
      <% }); %>
    </div>
  </section>
</body>
</html>
