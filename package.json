{
  "name": "axiom-demo-dashboard",
  "version": "1.0.0",
  "description": "Truxt demo dashboard - a small Express + EJS metrics dashboard used to demonstrate the Axiom vulnerability-remediation autopilot.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/ejs/package.json';const pkg=JSON.parse(fs.readFileSync(p,'utf8'));const ex=pkg.exports;if(ex&&!ex['./package.json']){pkg.exports=ex['.']?{...ex,'./package.json':'./package.json'}:{'.':ex,'./package.json':'./package.json'};fs.writeFileSync(p,JSON.stringify(pkg,null,2)+'\\n');}\""
  },
  "license": "MIT",
  "dependencies": {
    "axios": "1.18.0",
    "ejs": "6.0.1",
    "express": "4.22.2",
    "lodash": "4.18.1",
    "minimist": "1.2.8"
  },
  "devDependencies": {
    "eslint": "8.57.0"
  }
}
